{
  "description": "Bellerophon session-wide rule discovery, approval, and enforcement hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"D:/Bellerophon2/Bellerophon/.codex/hooks/Invoke-RuleHook.ps1\" -ScriptName \"Initialize-RuleSession.ps1\"",
            "timeout": 20,
            "statusMessage": "프로젝트 규칙 로드 중",
            "additionalContextLimit": 100000
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"D:/Bellerophon2/Bellerophon/.codex/hooks/Invoke-RuleHook.ps1\" -ScriptName \"Initialize-RuleSession.ps1\"",
            "timeout": 20,
            "statusMessage": "하위 에이전트 프로젝트 규칙 로드 중",
            "additionalContextLimit": 100000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"D:/Bellerophon2/Bellerophon/.codex/hooks/Invoke-RuleHook.ps1\" -ScriptName \"Capture-RuleApproval.ps1\"",
            "timeout": 10,
            "statusMessage": "규칙 승인 상태 확인 중",
            "additionalContextLimit": 100000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"D:/Bellerophon2/Bellerophon/.codex/hooks/Invoke-RuleHook.ps1\" -ScriptName \"Guard-RuleCompliance.ps1\"",
            "timeout": 15,
            "statusMessage": "규칙 준수 확인 중"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"D:/Bellerophon2/Bellerophon/.codex/hooks/Invoke-RuleHook.ps1\" -ScriptName \"Guard-RuleCompliance.ps1\"",
            "timeout": 15,
            "statusMessage": "권한 요청의 규칙 준수 확인 중"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"D:/Bellerophon2/Bellerophon/.codex/hooks/Invoke-RuleHook.ps1\" -ScriptName \"Audit-RuleToolResult.ps1\"",
            "timeout": 20,
            "statusMessage": "도구 실행 결과 규칙 감사 중",
            "additionalContextLimit": 100000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"D:/Bellerophon2/Bellerophon/.codex/hooks/Invoke-RuleHook.ps1\" -ScriptName \"Check-RuleViolations.ps1\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"D:/Bellerophon2/Bellerophon/.codex/hooks/Invoke-RuleHook.ps1\" -ScriptName \"Check-RuleViolations.ps1\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
